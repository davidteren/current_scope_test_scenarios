<%= form_with model: report do |f| %>
  <div class="mb-3">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :state, class: "form-label" %>
    <%= f.text_field :state, class: "form-control" %>
  </div>
  <%= f.submit class: "btn btn-primary" %>
<% end %>
