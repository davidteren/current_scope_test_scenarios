<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Legacy Reports" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>

  <body>
    <nav class="navbar navbar-expand bg-body-tertiary mb-4">
      <div class="container">
        <a class="navbar-brand" href="/">Legacy Reports</a>
        <div class="navbar-nav">
          <%= link_to "Dashboard", dashboard_path, class: "nav-link" %>
          <%= link_to "Reports", reports_path, class: "nav-link" %>
          <%= link_to "Admin", admin_reports_path, class: "nav-link" %>
          <%= link_to "Permissions", "/permissions", class: "nav-link" %>
        </div>
        <span class="navbar-text ms-auto">
          <% if current_user %>
            <%= current_user.name %> · <%= button_to "Log out", session_path(current_user), method: :delete, class: "btn btn-sm btn-outline-secondary" %>
          <% else %>
            <%= link_to "Log in", sessions_path %>
          <% end %>
        </span>
      </div>
    </nav>
    <main class="container">
      <%= yield %>
    </main>
  </body>
</html>
