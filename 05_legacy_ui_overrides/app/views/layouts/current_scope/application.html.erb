<%# HOST OVERRIDE of the engine layout — standard Rails view-path precedence:
    app/views/layouts/current_scope/application.html.erb shadows the engine's
    copy. This is the only retheme mechanism; nothing is documented. %>
<!DOCTYPE html>
<html>
  <head>
    <title>Permissions · Legacy Reports</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%# Keep the engine's own CSS+JS: its views are cs-* class soup without it. %>
    <%= stylesheet_link_tag "current_scope/application", media: "all" %>
    <%= javascript_include_tag "current_scope/application", defer: true %>
  </head>
  <body>
    <!-- HOST-CS-OVERRIDE -->
    <nav class="navbar navbar-expand bg-body-tertiary mb-4">
      <div class="container">
        <a class="navbar-brand" href="<%= main_app.root_path %>">Legacy Reports</a>
        <div class="navbar-nav">
          <%= link_to "Roles", roles_path, class: "nav-link" %>
          <%= link_to "Subjects", subjects_path, class: "nav-link" %>
          <%= link_to "Events", events_path, class: "nav-link" %>
        </div>
        <span class="navbar-text ms-auto">Back to <%= link_to "app", main_app.root_path %></span>
      </div>
    </nav>
    <main class="container">
      <% if notice.present? %><div class="alert alert-success"><%= notice %></div><% end %>
      <% if alert.present? %><div class="alert alert-danger"><%= alert %></div><% end %>
      <%= yield %>
    </main>
  </body>
</html>
