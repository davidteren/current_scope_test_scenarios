<h1>Log in as…</h1>
<ul class="list-group" style="max-width: 24rem">
  <% @users.each do |user| %>
    <li class="list-group-item d-flex justify-content-between align-items-center">
      <span><%= user.name %> <small class="text-muted"><%= user.email %></small></span>
      <%= button_to "Log in", sessions_path, params: { user_id: user.id }, class: "btn btn-sm btn-primary" %>
    </li>
  <% end %>
</ul>
